PAPERLESS_URL=http://localhost:8000
PAPERLESS_API_TOKEN=your-api-token-here

# Preferred: Claude CLI credential file auth (handles automatic token refresh)
CLAUDE_OAUTH_ACCESS_TOKEN=your-access-token-here
CLAUDE_OAUTH_REFRESH_TOKEN=your-refresh-token-here

# Legacy: direct env var auth (token expires after ~1 hour, no auto refresh)
# CLAUDE_CODE_OAUTH_TOKEN=your-claude-oauth-token-here

CLAUDE_MODEL=sonnet
PROCESSED_TAG=processed-by-ai
MODE=merge
POLL_INTERVAL=300
LOG_LEVEL=info
DRY_RUN=false
BATCH_SIZE=10
BATCH_DELAY=5
CUSTOM_PROMPT=
MAX_CONTENT_LENGTH=50000
